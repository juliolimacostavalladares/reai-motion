{
	"repository": {
		"url": "https://github.com/remotion-dev/remotion/tree/main/packages/ai-video-studio"
	},
	"name": "@remotion/ai-video-studio",
	"version": "4.0.458",
	"description": "AI-powered video creation studio for Remotion",
	"main": "dist/index.js",
	"sideEffects": false,
	"scripts": {
		"dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
		"dev:backend": "tsx watch src/server/index.ts",
		"dev:frontend": "cd web-ui && bun run dev",
		"build": "tsgo -d && bun run build:frontend",
		"build:frontend": "cd web-ui && bun run build",
		"lint": "eslint src",
		"formatting": "oxfmt src --check",
		"format": "oxfmt src",
		"test": "bun test src",
		"mcp:server": "tsx src/mcp/server.ts"
	},
	"dependencies": {
		"remotion": "workspace:*",
		"@remotion/bundler": "workspace:*",
		"@remotion/renderer": "workspace:*",
		"@remotion/studio": "workspace:*",
		"@remotion/studio-server": "workspace:*",
		"@remotion/player": "workspace:*",
		"@remotion/media-utils": "workspace:*",
		"express": "^4.18.2",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"zod": "catalog:",
		"colorthief": "^2.4.0",
		"cheerio": "^1.0.0-rc.12",
		"axios": "^1.6.2",
		"uuid": "^9.0.1"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/cors": "^2.8.17",
		"@types/node": "catalog:",
		"@types/bun": "catalog:",
		"@remotion/eslint-config-internal": "workspace:*",
		"eslint": "catalog:",
		"typescript": "catalog:",
		"tsx": "^4.7.0",
		"concurrently": "^8.2.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
